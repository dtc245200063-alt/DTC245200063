# ==========================================
# Cau hinh mau cho De 3 - WordPress Demo
# Sao chep file nay thanh .env va doi mat khau
# ==========================================

# Server IP / Domain
SERVER_IP=192.168.102.128

# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password_16chars
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_app
MYSQL_PASSWORD=change_this_wp_password_16chars
MYSQL_EXPORTER_PASSWORD=change_this_exporter_password_16chars

# WordPress Application
WP_ADMIN_USER=quantri
WP_ADMIN_PASSWORD=change_this_admin_password_16chars
WP_ADMIN_EMAIL=quantri@example.local
WP_EDITOR_USER=bientap01
WP_EDITOR_PASSWORD=change_this_editor_password_16chars
WP_EDITOR_EMAIL=bientap01@example.local

# WordPress Salts
AUTH_KEY=generate_random_key_here
SECURE_AUTH_KEY=generate_random_key_here
LOGGED_IN_KEY=generate_random_key_here
NONCE_KEY=generate_random_key_here
AUTH_SALT=generate_random_key_here
SECURE_AUTH_SALT=generate_random_key_here
LOGGED_IN_SALT=generate_random_key_here
NONCE_SALT=generate_random_key_here

# Monitoring Services
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_16chars
